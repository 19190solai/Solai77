* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f0f4f8;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.quiz-container {
    background: white;
    width: 90%;
    max-width: 500px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

h1 {
    text-align: center;
    margin-bottom: 25px;
}

#question {
    margin-bottom: 20px;
}

.answer-btn {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    text-align: left;
    font-size: 16px;
}

.answer-btn:hover {
    background: #e8f0fe;
}

.correct {
    background: #90ee90 !important;
}

.wrong {
    background: #ff9999 !important;
}

#next-btn {
    width: 100%;
    padding: 12px;
    margin-top: 15px;
    border: none;
    border-radius: 8px;
    background: #333;
    color: white;
    font-size: 17px;
    cursor: pointer;
}

.hide {
    display: none;
}

#result {
    text-align: center;
}

#result button {
    margin-top: 20px;
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    background: #333;
    color: white;
    cursor: pointer;
}
